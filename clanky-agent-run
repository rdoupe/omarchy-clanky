#!/usr/bin/python3
"""Run an agent CLI with producer-side stdout/stderr byte ceilings.

Clanky's QML Process uses unbounded StdioCollectors. This helper is the
security boundary in front of them: it is the only process Quickshell
collects from, and it never forwards more than the configured ceilings.
Crossing a ceiling is fail-closed — the agent process tree and process
group are terminated (SIGTERM, then SIGKILL) and the helper does not
exit until that group is empty (or a short reap deadline elapses).
Exit status 125 means overflow.

Usage:
  clanky-agent-run [--stdout-bytes N] [--stderr-bytes N] -- cmd [args...]

Stdin is inherited (QML writes the prompt and closes the pipe). The 180s
ask timeout stays in QML as a secondary limit.
"""
from __future__ import annotations

import argparse
import os
import signal
import stat
import subprocess
import sys
import threading
import time

DEFAULT_STDOUT_BYTES = 64 * 1024
DEFAULT_STDERR_BYTES = 16 * 1024
EXIT_OVERFLOW = 125
KILL_GRACE_S = 0.2
REAP_DEADLINE_S = 1.0
TRUSTED_PATH_DIRS = (
    "/usr/local/bin",
    "/usr/bin",
    "/bin",
    "/usr/sbin",
    "/sbin",
)
FALLBACK_PATH = "/usr/bin:/bin"

_child = None
_child_pgid = None
_overflow = threading.Event()
_stopping = threading.Event()


def _is_safe_abs_path(path):
    p = str(path or "")
    if len(p) < 2 or p[0] != "/":
        return False
    if "/./" in p or "/../" in p:
        return False
    if p.endswith("/.") or p.endswith("/.."):
        return False
    return True


def _normalize_abs_dir(path):
    p = str(path or "")
    if p.endswith("/"):
        p = p[:-1]
    return p if _is_safe_abs_path(p) else ""


def _is_safe_bare_name(name):
    n = str(name or "")
    return n not in ("", ".", "..") and "/" not in n


def agent_launcher_dirs(env):
    """System bins, then Omarchy mise shims and ~/.local/bin. Not inherited PATH."""
    dirs = []
    seen = set()

    def add(path):
        p = _normalize_abs_dir(path)
        if p and p not in seen:
            seen.add(p)
            dirs.append(p)

    for trusted in TRUSTED_PATH_DIRS:
        add(trusted)
    add(env.get("MISE_SHIMS_DIR", ""))
    data_dir = _normalize_abs_dir(env.get("MISE_DATA_DIR", ""))
    if data_dir:
        add(data_dir + "/shims")
    data_home = _normalize_abs_dir(env.get("XDG_DATA_HOME", ""))
    home = _normalize_abs_dir(env.get("HOME", ""))
    if not data_home and home:
        data_home = home + "/.local/share"
    if data_home:
        add(data_home + "/mise/shims")
    if home:
        add(home + "/.local/bin")
    return dirs


def _owned_by_self_or_root(st):
    return st.st_uid in (os.geteuid(), 0)


def _not_writable_by_others(st):
    return not (st.st_mode & (stat.S_IWGRP | stat.S_IWOTH))


def _dir_ok_for_launch(directory):
    """Skip group/world-writable or foreign-owned dirs from inherited MISE_*/XDG paths."""
    try:
        st = os.stat(directory)
    except OSError:
        return False
    return (
        stat.S_ISDIR(st.st_mode)
        and _owned_by_self_or_root(st)
        and _not_writable_by_others(st)
    )


def _walk_ancestors(path):
    current = os.path.dirname(os.path.abspath(path))
    seen = set()
    while current and current not in seen:
        yield current
        seen.add(current)
        nxt = os.path.dirname(current)
        if nxt == current:
            break
        current = nxt


def _ancestors_ok(path):
    targets = [path]
    try:
        targets.append(os.path.realpath(path))
    except OSError:
        pass
    seen = set()
    for target in targets:
        if not target or target in seen:
            continue
        seen.add(target)
        for directory in _walk_ancestors(target):
            if not _dir_ok_for_launch(directory):
                return False
    return True


def _launcher_ok(path):
    try:
        st = os.stat(path)
    except OSError:
        return False
    if not stat.S_ISREG(st.st_mode):
        return False
    if not os.access(path, os.X_OK):
        return False
    if not (_owned_by_self_or_root(st) and _not_writable_by_others(st)):
        return False
    return _ancestors_ok(path)


def resolve_agent_launcher(name, dirs, exists):
    raw = str(name or "")
    if raw.startswith("/"):
        if _is_safe_abs_path(raw) and _launcher_ok(raw):
            return raw
        return ""
    if not _is_safe_bare_name(raw):
        return ""
    for directory in dirs:
        directory = _normalize_abs_dir(directory)
        if not directory or not _dir_ok_for_launch(directory):
            continue
        candidate = directory + "/" + raw
        if _is_safe_abs_path(candidate) and exists(candidate):
            return candidate
    return ""


def _launcher_exists(path):
    return _launcher_ok(path)


def resolve_agent_command(command, env):
    if not command:
        return [], env.get("PATH") or FALLBACK_PATH
    raw = str(command[0] or "")
    resolved = resolve_agent_launcher(raw, agent_launcher_dirs(env), _launcher_exists)
    if not resolved:
        # Rejected absolute launchers must not reach Popen.
        if raw.startswith("/"):
            return [], env.get("PATH") or FALLBACK_PATH
        return list(command), env.get("PATH") or FALLBACK_PATH
    path = env.get("PATH") or FALLBACK_PATH
    directory = os.path.dirname(resolved)
    known = set(agent_launcher_dirs(env))
    if (
        directory in known
        and directory not in TRUSTED_PATH_DIRS
        and directory not in path.split(":")
    ):
        path = directory + ":" + path
    return [resolved] + list(command[1:]), path


def _parse_args(argv):
    parser = argparse.ArgumentParser(
        prog="clanky-agent-run",
        add_help=True,
    )
    parser.add_argument(
        "--stdout-bytes",
        type=int,
        default=DEFAULT_STDOUT_BYTES,
        metavar="N",
        help="max forwarded stdout bytes (default: %(default)s)",
    )
    parser.add_argument(
        "--stderr-bytes",
        type=int,
        default=DEFAULT_STDERR_BYTES,
        metavar="N",
        help="max forwarded stderr bytes (default: %(default)s)",
    )
    parser.add_argument(
        "command",
        nargs=argparse.REMAINDER,
        help="agent command; use -- before the command",
    )
    args = parser.parse_args(argv)
    if args.stdout_bytes < 1 or args.stderr_bytes < 1:
        parser.error("byte ceilings must be >= 1")
    command = list(args.command)
    if command and command[0] == "--":
        command = command[1:]
    if not command:
        parser.error("missing command")
    return args.stdout_bytes, args.stderr_bytes, command


def _child_preexec():
    """Die if the helper (parent) disappears. Session is set by Popen."""
    try:
        import ctypes

        libc = ctypes.CDLL("libc.so.6", use_errno=True)
        # PR_SET_PDEATHSIG = 1, SIGKILL = 9
        libc.prctl(1, 9)
        if os.getppid() == 1:
            os.kill(os.getpid(), signal.SIGKILL)
    except (OSError, AttributeError):
        pass


def _stat_ppid_pgrp(pid):
    with open("/proc/%d/stat" % pid, "r", encoding="utf-8") as fh:
        stat = fh.read()
    rparen = stat.rfind(")")
    if rparen < 0:
        raise ValueError("stat")
    fields = stat[rparen + 2 :].split()
    if len(fields) < 3:
        raise ValueError("stat")
    return int(fields[1]), int(fields[2])


def _proc_pids():
    try:
        names = os.listdir("/proc")
    except OSError:
        return []
    out = []
    for name in names:
        if name.isdigit():
            out.append(int(name))
    return out


def _descendants(root):
    """PIDs of root and every living descendant, via /proc ppid walk."""
    if root is None:
        return []
    children_of = {}
    for pid in _proc_pids():
        try:
            ppid, _pgrp = _stat_ppid_pgrp(pid)
        except (OSError, ValueError):
            continue
        children_of.setdefault(ppid, []).append(pid)

    out = []
    seen = set()
    stack = [root]
    while stack:
        pid = stack.pop()
        if pid in seen:
            continue
        seen.add(pid)
        out.append(pid)
        stack.extend(children_of.get(pid, []))
    return out


def _group_pids(pgid):
    if pgid is None:
        return []
    found = []
    for pid in _proc_pids():
        try:
            _ppid, pgrp = _stat_ppid_pgrp(pid)
        except (OSError, ValueError):
            continue
        if pgrp == pgid:
            found.append(pid)
    return found


def _pgid(pid):
    if pid is None:
        return None
    try:
        return os.getpgid(pid)
    except OSError:
        return None


def _alive(pid):
    try:
        os.kill(pid, 0)
        return True
    except OSError:
        return False


def _living(pids):
    return [pid for pid in pids if _alive(pid)]


def _signal_tree(root, pgid, sig):
    pids = set(_descendants(root))
    pids.update(_group_pids(pgid))
    if pgid is not None:
        try:
            os.killpg(pgid, sig)
        except OSError:
            pass
    for pid in pids:
        try:
            os.kill(pid, sig)
        except OSError:
            pass
    return pids


def _tree_living(root, pgid):
    return _living(_descendants(root) + _group_pids(pgid))


def kill_tree(root, pgid=None):
    """Fail-closed teardown: TERM, KILL, then wait until the group is empty."""
    if root is None and pgid is None:
        return
    if pgid is None:
        pgid = _pgid(root)
    _signal_tree(root, pgid, signal.SIGTERM)
    deadline = time.monotonic() + KILL_GRACE_S
    while time.monotonic() < deadline:
        if not _tree_living(root, pgid):
            return
        time.sleep(0.02)
    reap_until = time.monotonic() + REAP_DEADLINE_S
    while True:
        _signal_tree(root, pgid, signal.SIGKILL)
        if not _tree_living(root, pgid):
            return
        if time.monotonic() >= reap_until:
            return
        time.sleep(0.02)


def _close_child_pipes(child):
    if child is None:
        return
    for pipe in (child.stdout, child.stderr):
        if pipe is None:
            continue
        try:
            pipe.close()
        except OSError:
            pass


def _pump(src, dst, ceiling):
    remaining = ceiling
    try:
        while remaining > 0 and not _stopping.is_set():
            chunk = src.read(min(65536, remaining))
            if not chunk:
                return
            dst.write(chunk)
            dst.flush()
            remaining -= len(chunk)
        extra = src.read(1) if remaining == 0 and not _stopping.is_set() else b""
        if extra:
            _trip_overflow()
    except (OSError, ValueError):
        return


def _trip_overflow():
    if _overflow.is_set():
        return
    _overflow.set()
    _stopping.set()
    child = _child
    if child is not None and child.pid:
        kill_tree(child.pid, _child_pgid)
        _close_child_pipes(child)


def _on_signal(signum, _frame):
    _stopping.set()
    child = _child
    if child is not None and child.pid:
        kill_tree(child.pid, _child_pgid)
        _close_child_pipes(child)
    os._exit(128 + signum)


def main(argv=None):
    global _child, _child_pgid
    stdout_max, stderr_max, command = _parse_args(
        sys.argv[1:] if argv is None else argv
    )

    signal.signal(signal.SIGTERM, _on_signal)
    signal.signal(signal.SIGINT, _on_signal)
    signal.signal(signal.SIGHUP, _on_signal)

    child_env = os.environ.copy()
    command, child_path = resolve_agent_command(command, child_env)
    child_env["PATH"] = child_path
    if not command:
        sys.stderr.write("clanky-agent-run: untrusted or missing command\n")
        return 127

    try:
        _child = subprocess.Popen(
            command,
            stdin=None,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            env=child_env,
            start_new_session=True,
            preexec_fn=_child_preexec,
        )
    except FileNotFoundError:
        sys.stderr.write("clanky-agent-run: command not found: %s\n" % command[0])
        return 127
    except OSError as exc:
        sys.stderr.write("clanky-agent-run: failed to start: %s\n" % exc)
        return 126

    try:
        _child_pgid = os.getpgid(_child.pid)
    except OSError:
        _child_pgid = _child.pid

    t_out = threading.Thread(
        target=_pump,
        args=(_child.stdout, sys.stdout.buffer, stdout_max),
        daemon=True,
    )
    t_err = threading.Thread(
        target=_pump,
        args=(_child.stderr, sys.stderr.buffer, stderr_max),
        daemon=True,
    )
    t_out.start()
    t_err.start()

    rc = _child.wait()
    # Do not return to QML while any member of the agent group is still live.
    kill_tree(_child.pid, _child_pgid)
    t_out.join(timeout=1.0)
    t_err.join(timeout=1.0)
    if _overflow.is_set():
        return EXIT_OVERFLOW
    return rc if rc is not None else 1


if __name__ == "__main__":
    sys.exit(main())
